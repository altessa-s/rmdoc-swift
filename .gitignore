# SwiftPM
.build/
.swiftpm/
Package.resolved

# What Scripts/build-xcframework.sh produces: the archives it passes to
# `xcodebuild -create-xcframework` and the framework itself. Output, and the
# consumer keeps its own copy of the artefact.
build/
*.xcframework

.DS_Store

# Generated by XcodeGen from project.yml, and only so that
# Scripts/build-xcframework.sh has a framework target to archive. The name
# follows `name:` in project.yml — it was RMLines.xcodeproj here for long
# enough that the generated project was committed instead of ignored.
RMDoc.xcodeproj/

# The knowledge graph /graphify builds from this repo: HTML, report, node
# data and its extraction cache. Derived from the sources beside it and
# rebuilt on demand, so it is output rather than something to carry.
graphify-out/
